# Copier ce fichier en .env et renseigner la clé API.
# La clé reste côté serveur, jamais exposée au navigateur.

ANTHROPIC_API_KEY=
MODEL=claude-sonnet-4-6
# Modèle de l'agent qui comprend les actions libres. Sans valeur, MODEL est utilisé.
INTERPRETER_MODEL=
PORT=3000

# Voix (optionnel) — synthèse vocale du personnage via ElevenLabs.
# Sans ces variables, le jeu se joue normalement ; seule la voix est désactivée.
# La clé reste côté serveur, jamais exposée au navigateur.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
