# Copier ce fichier en .env et renseigner la clé API.
# La clé reste côté serveur, jamais exposée au navigateur.

ANTHROPIC_API_KEY=
MODEL=claude-sonnet-5-5
# Profils du chat orchestré. Sans valeur, le personnage utilise MODEL.
MODELE_SCENE_PERSONNAGE=
# Haiku 5.5 n’est pas encore disponible ; cet identifiant est remplaçable.
MODELE_SCENE_EXPLORATION=claude-haiku-4-5-20251001
# Modèle de l’interprète historique (routes de compatibilité uniquement). Sans valeur, MODEL est utilisé.
INTERPRETER_MODEL=
PORT=3000

# Voix (optionnel) — synthèse vocale du personnage via ElevenLabs.
# Sans ces variables, le jeu se joue normalement ; seule la voix est désactivée.
# La clé reste côté serveur, jamais exposée au navigateur.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
